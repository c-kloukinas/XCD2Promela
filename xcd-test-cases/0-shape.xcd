// -*- mode: java -*-
enum Amount := {None, Little, Average, Much};

typedef byte ID;

component comp1(){
    enum Amount := {None, Little, Average, Much};
    typedef byte ID;
    bool requestMade := false;
    Amount chosenAmount :=  Little;
    emitter port emitter1 {
        @functional{
            when: true;
            ensures:  requestMade := amount := chosenAmount;
        }
        emiOne(Amount amount);
    }
    consumer port consumer1{
        @interaction{
            waits: requestMade==true;
        }
        @functional{
            requires: am == chosenAmount  ;
            ensures: requestMade:=false;
        }
        reqOne(Amount am);
    }
}

component comp2(){
    bool requestMade := false;
    Amount chosenAmount :=  Little;
	isTrue (bool a) { return a; }
	negate (bool a) { return !a; }
	areEqual(Amount a, Amount b) { return a==b; }
    emitter port emitter2 {
        @functional{
            when: true;
            ensures:  amount := chosenAmount;
        }
        emiTwo(Amount amount);
        @interaction{
            waits: negate(requestMade);
        }
        @functional{
            when: true;
            ensures:  amount := chosenAmount;
        }
        emiThree(Amount amount);
    }
    consumer port consumer2{
        @interaction{
            waits: isTrue(requestMade);
        }
        @functional{
            requires: areEqual(am, chosenAmount)  ;
            ensures: requestMade:=false;
        }
        reqTwo(Amount am);
        @interaction{
            waits: requestMade==true;
        }
        @functional{
            requires: am == chosenAmount  ;
            ensures: requestMade:=false;
        }
        reqThree(Amount am);
    }
}

connector client2server_deadlock(byte numOfClients, client{service}, server{service}){
    role client [@ic:numOfClients]{
        bool opened := false;
        byte clientIndex := @ic;
        required port_variable service {
            @interaction{
                allows: !opened ;
                ensures: opened := true;
            }
            void open();
            @interaction{
                allows: opened;
                ensures: opened := false;
            }
            void close();
            @interaction{
                allows: opened && clientIndex == @ic;
                ensures: clientIndex \in [0, numOfClients-1];
            }
            byte request();
        }
    }
    role server {
        bool opened:=false;
        provided port_variable service{
            @interaction{
                allows: !opened;
                ensures: opened:=true;
            }
            void open();
            @interaction{
                allows: opened ;
                ensures: opened:= false;
            }
            void close();
            @interaction{
                allows: opened;
                ensures: assert(true);
            }
            byte request();
        }
    }
    connector client2server_internal internal( numOfClients, client{service}, server{service});
}

connector client2server_internal(byte numOfClients, client{service}, server{service}){
    role client [@ic:numOfClients]{
        bool icopened := false;
        byte icclientIndex := @ic;
        required port_variable service {
            @interaction{
                allows: !icopened ;
                ensures: icopened := true;
            }
            void open();
            @interaction{
                allows: icopened;
                ensures: icopened := false;
            }
            void close();
            @interaction{
                allows: icopened && icclientIndex == @ic;
                ensures: icclientIndex \in [0, numOfClients-1];
            }
            byte request();
        }
    }
    role server {
        bool isopened:=false;
        provided port_variable service{
            @interaction{
                allows: !isopened;
                ensures: isopened:=true;
            }
            void open();
            @interaction{
                allows: isopened ;
                ensures: isopened:= false;
            }
            void close();
            @interaction{
                allows: isopened;
                ensures: assert(true);
            }
            byte request();
        }
    }
    connector proc link[@lc:numOfClients](client[@lc]{service}, server{service});
}
