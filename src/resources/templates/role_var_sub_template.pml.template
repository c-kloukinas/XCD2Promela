dnl#### Start of connector $<connector_name>, role $<role_name> definitions
dnl #
dnl # Prefix of role#$<rlIndex>
dnl #
pushdef(`__prefixR',__roleId(_context,$<connector_name>,_varname,$<rlIndex>))dnl
dnl #
dnl # Extra role data from sub-connector roles bound to this one.
dnl #
dnl ifdef(_NAME(__prefixR,ActualName),,define(_NAME(__prefixR,ActualName),__prefixR))dnl
dnl ifdef(_NAME(__prefixR,ActualNameLHS),,define(_NAME(__prefixR,ActualNameLHS),__prefixR))dnl
dnl
define(_NAME(__prefixR,ExtraRoleData),)dnl start with empty definition & collect
define(_NAME(__prefixR,ExtraRoleDataInitialisations),)dnl start with empty definition & collect
$<subExtraRoleData>
dnl
popdef(`__ParentComponent')dnl
dnl #
dnl # Name of role#$<rlIndex>
dnl #
dnl define(_NAME(__prefixX,RlNm$<rlIndex>),`$<role_name>')dnl
define(_NAME(__prefixR,Name),`$<role_name>')dnl
dnl #
dnl # Name of role#$<rlIndex> iterator
dnl #
define(_NAME(__prefixR,Iterator),$<roleIterator>)dnl
dnl #
dnl # Size expr, and size of the role
dnl #
define(_NAME(__prefixR,sizeExpr),`$<roleArraySize>')dnl
define(_NAME(__prefixR,size),`eval('_EVALNAME(__prefixR,sizeExpr)`)')dnl
define(_NAME(__prefixR,sizeTotal),`eval('_EVALNAME(__prefixR,size) * (_varsize)`)')dnl
dnl #
dnl # Size checker of role#$<rlIndex>
dnl #
define(_NAME(__prefixR,checkSize),`dnl
dnl Delay evaluation of $1 below, so it is the $1 of checkSize, and _NOT_
dnl that of the connector macro (within which checkSize is defined).
pushdef(`__mySizeShouldBeExpr',$'`1)dnl
pushdef(`__mySizeShouldBe',eval(__mySizeShouldBeExpr))dnl
ifelse(__mySizeShouldBe,'_EVALNAME(__prefixR,size)`,,dnl
dnl Below we use two quotes because we are inside the quoted _error,
dnl which is inside the quoted macro definition body
`_error(Role array size ("''_NAME(__prefixR,sizeExpr)" = _EVALNAME(__prefixR,size)``) is different to size passed ("__mySizeShouldBeExpr" = __mySizeShouldBe).
)')dnl
popdef(`__mySizeShouldBe')dnl
popdef(`__mySizeShouldBeExpr')dnl
')dnl
dnl #
dnl # Typedefs of role#$<rlIndex>
dnl #
dnl # Name of the type of the role variables
pushdef(`__prefixRType',_NAME(__prefixR,Type))dnl
define(_NAME(__prefixR,Fields),$<role_variables>
_EVALNAME(__prefixR,ExtraRoleData))dnl
dnl If $ <role_variables> are empty, then define typedefs,etc. to be empty:
ifelse(_CAT(_is_empty,_EVALNAME(__prefixR,Fields)),_is_empty,`dnl Empty definitions (when no variables)
define(_NAME(__prefixR,typedef),)dnl
define(_NAME(__prefixR,typedefs),)dnl
define(_NAME(__prefixR,vardecl),)dnl
define(_NAME(__prefixR,vardecls),)dnl
define(_NAME(__prefixR,FieldInitialisations),)dnl
define(_NAME(__prefixR,inits),)dnl
',`dnl Normal definitions, for when $ <role_variables> are not empty:
dnl NOTE: then/else parts MUST be quoted, otherwise the else definitions
dnl will always be used
dnl #
dnl # Type definition for the structure containing the role variables.
dnl #
dnl # role variables should also contain the variables of any          TODO XXX
dnl # sub-connector roles that this role has been associated with
define(_NAME(__prefixR,typedef),dnl
  typedef `$'1 {
        `$'2`'dnl
  };dnl
)dnl
ifdef(_NAME(__prefixR,typedefs),,dnl
dnl
define(_NAME(__prefixR,typedefs),dnl
_EVALNAME(__prefixR,typedef)(__prefixRType,_NAME(__prefixR,Fields))dnl
dnl
dnl add typedef to global type definitions
dnl
dnl the ifdef is really to avoid redefining the same type here
define(`__GLOBAL_TYPEDEFS',dnl
defn(`__GLOBAL_TYPEDEFS')dnl
_NAME(__prefixR,typedefs) dnl

)dnl
)dnl
)dnl
dnl #
dnl # Role variable (structure) declaration
dnl #
define(_NAME(__prefixR,vardecl),dnl type,varname,varsize
   `$'1 `$'2[`$'3];
)
define(_NAME(__prefixR,vardecls),dnl
dnl list of: $<var_type> _NAME(_context,_varname,$<var_name>);
_EVALNAME(__prefixR,vardecl)(__prefixRType,__prefixR,_EVALNAME(__prefixR,sizeTotal))dnl $< connector_variables>
dnl
define(`__GLOBAL_VARDECLS',defn(`__GLOBAL_VARDECLS')dnl
 _NAME(__prefixR,vardecls)))dnl
dnl #
dnl # Role variable initialisations
dnl #
dnl # role variable initialisation code should also contain the        TODO XXX
dnl # initialisation of any sub-connector role variables that this
dnl # role has been associated with
define(_NAME(__prefixR,FieldInitialisations),dnl
  _CAT($<role_variable_initialisations>)dnl
_forloop(_EVALNAME(__prefixR,Iterator),0,_EVALNAME(__prefixR,sizeTotal),dnl
  _EVALNAME(__prefixR,ExtraRoleDataInitialisations)`'dnl
)dnl
)dnl
define(_NAME(__prefixR,inits),dnl
/** Initialising role $<role_name> **/
ifelse(_CAT(_is_empty,_EVALNAME(__prefixR,FieldInitialisations)),_is_empty,,dnl
d_step {
   _EVALNAME(__prefixR,FieldInitialisations)
}
dnl
define(`__GLOBAL_INITS',defn(`__GLOBAL_INITS') _NAME(__prefixR,inits))dnl
)dnl
)dnl
')dnl
dnl #
dnl # Role ports
dnl #
$<connector_role_port>`'dnl
popdef(`__prefixRType')dnl
popdef(`__prefixR')dnl
dnl#### End of connector $<connector_name>, role $<role_name> definitions
